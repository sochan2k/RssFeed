# Copy this file to .env and fill in your values. Never commit .env to git.

GEMINI_API_KEY=your_gemini_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated list of Telegram chat IDs to receive the digest
TELEGRAM_CHAT_IDS=123456789

# Admin chat ID for error alerts (defaults to first TELEGRAM_CHAT_IDS if omitted)
ADMIN_CHAT_ID=123456789

# Daily digest time in ICT (UTC+7). Format: HH:MM. Default: 08:00
# DIGEST_SCHEDULE_TIME=08:00

# --- Price data for portfolio P&L (optional) ---
# Provider for live quotes. "yfinance" (default) needs no API key.
# Set to "finnhub" for a more reliable feed (free key at finnhub.io).
# PRICE_PROVIDER=yfinance
# FINNHUB_API_KEY=your_finnhub_key_here
# Seconds to cache quotes in memory (default 60)
# PRICE_CACHE_TTL_SECONDS=60
